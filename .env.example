# Trove configuration. Copy to .env - docker compose reads it automatically.
# Every value here is optional. Trove generates what it needs on first start.

# --- Where things live -------------------------------------------------------
# The database, the browser profiles, the screenshots and the two generated
# secrets. In Docker this is the mounted volume and should stay /data.
DATA_DIR=/data

# --- The one account that signs in to Trove itself ---------------------------
# Set this before the first start. Left blank the password is "changeme" and
# the log says so loudly. Trove holds live store sessions, so this matters more
# than it does for most self-hosted apps.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Security ----------------------------------------------------------------
# Signs the session cookie. Generated into <DATA_DIR>/.secret_key on first
# start. Changing it signs you out and nothing worse.
# Generate one with: openssl rand -base64 48
SECRET_KEY=

# Encrypts the things in the database that are worth stealing: claimed game
# keys, TOTP secrets, and the notification webhook. Generated into
# <DATA_DIR>/.credential_key on first start. Changing it makes every value
# already encrypted unreadable, and they have to be entered again.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=

# --- The browser -------------------------------------------------------------
# Headed is the default and is the safer guess: headless is one of the signals
# bot detection reads. The container runs a virtual display so headed works
# there too. Set true only if you want to measure the difference.
TROVE_HEADLESS=false

# Which browser to drive. "auto" uses real Google Chrome when it is installed
# and falls back to Playwright's bundled Chromium; "chromium" forces the bundle.
#
# Leave this on auto. The bundled Chromium ships no H.264, HEVC or AAC while
# its user-agent claims to be Chrome, and Cloudflare's captcha probes for
# exactly those codecs - so on the bundle a store can refuse to let you past a
# challenge however honestly you answer it. The Docker image installs Chrome
# for this reason. On a desktop install, install Chrome, or run
# `playwright install chrome` inside the virtualenv.
BROWSER_CHANNEL=auto

# How long one Playwright action may take before the run gives up and files the
# account for a person to look at.
BROWSER_TIMEOUT_MS=45000

# How long the live view stays open with nobody touching it.
LIVE_IDLE_TIMEOUT_S=600

# --- The schedule ------------------------------------------------------------
# Hours between runs for an account that does not set its own. Giveaways run
# for a week; checking every few hours is already generous, and checking every
# few minutes is how an account gets flagged.
DEFAULT_INTERVAL_HOURS=8

# Spread runs by this fraction of the interval, so they do not land on the
# same minute every day.
INTERVAL_JITTER=0.15

# The floor. A typo in the interface cannot go below this.
MIN_INTERVAL_HOURS=1

# --- Logging -----------------------------------------------------------------
# INFO, or DEBUG when a claim is not working and you want to see why. DEBUG
# also un-silences httpx, which logs full request URLs - including your
# notification webhook. Do not paste a DEBUG log into an issue.
LOG_LEVEL=INFO
TZ=Europe/Oslo
